#!/usr/bin/env python3
"""hd-public: the one program that performs a public act, run as Unix user `hd` through sudoers with the full GitHub
token (docs/ARCHITECTURE.md, Authority). It acts only when state/<slug>/approval.json names the head it is given.  R4

  hd-public upstream <slug> <head>        push head to the public branch on the change's fork (server or central); create the draft PR if none;
                                          wait for CI at head (a fact, polled); stop before anything public when it
                                          is not green; post or edit our comment naming the head; mark ready.
  hd-public release <slug> <head> <tag>   gh release create with the APK, the notices and the log from the evidence dir.
Until the `hd` user exists the pass runs it as the user and `hd` shows the R4 alert.
"""
import hashlib, json, re, subprocess, sys, time
from pathlib import Path
import yaml

ROOT = Path(__file__).resolve().parent
STATE, EVID, DEFS = ROOT / "state", ROOT / "evidence", ROOT / "harness"
ATTRIBUTION = "\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"


def sh(*args, inp=None):
    r = subprocess.run(args, capture_output=True, text=True, input=inp)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def approved(slug, head):
    """The yes names this head and the PR body the user saw (its digest)."""
    f = STATE / slug / "approval.json"
    a = json.loads(f.read_text()) if f.exists() else {}
    return a.get("head") == head and a.get("body") == hashlib.sha256(text(slug, "pr-body.md").encode()).hexdigest()[:16]


def change(slug):
    m = re.match(r"---\n(.*?)\n---", (DEFS / "changes" / f"{slug}.md").read_text(), re.S)
    return yaml.safe_load(m.group(1)) if m else {}


def text(slug, name):
    f = EVID / slug / name
    return f.read_text().strip() if f.exists() else ""


def checks(upstream, number, head):
    """'success' | 'failure' | 'pending' | 'none' for the PR's head."""
    rc, out, _ = sh("gh", "pr", "view", str(number), "-R", upstream, "--json", "headRefOid,statusCheckRollup")
    if rc:
        return "none"
    v = json.loads(out)
    if v.get("headRefOid") != head:
        return "none"
    states = set()
    for c in v.get("statusCheckRollup") or []:
        k = (c.get("conclusion") or c.get("state") or "").upper()
        states.add("pending" if c.get("status", "COMPLETED") != "COMPLETED" or k in ("", "PENDING", "EXPECTED")
                   else "success" if k in ("SUCCESS", "NEUTRAL", "SKIPPED") else "failure")
    return "failure" if "failure" in states else "pending" if "pending" in states else "success" if states else "none"


def upstream(slug, head):
    if not approved(slug, head):
        sys.exit(f"refused: no approval at {head}")
    c = yaml.safe_load((ROOT / "hd.yaml").read_text())
    ch = change(slug)
    fork = c["repos"]["central" if ch.get("track") == "central" else "fork"]  # the fork of the change's upstream: OpenRune-Server or OpenRune-Central-Server
    up, owner = fork["upstream"], fork["name"].split("/")[0]
    branch = ch.get("branch") or f"content/{slug}"
    rc, _, err = sh("git", "-C", str(Path(fork["path"]).expanduser()), "push", "-q", "fork", f"{head}:refs/heads/{branch}")
    if rc:
        sys.exit(f"push failed: {err}")
    print(f"pushed {head[:9]} to fork {branch}")
    rc, out, _ = sh("gh", "pr", "list", "-R", up, "--head", f"{owner}:{branch}", "--state", "open", "--json", "number")
    prs = json.loads(out) if rc == 0 and out else []
    if prs:
        number = prs[0]["number"]
    else:
        rc, out, err = sh("gh", "pr", "create", "-R", up, "--draft", "--base", "main", "--head", f"{owner}:{branch}",
                          "--title", text(slug, "pr-title.txt"), "--body", text(slug, "pr-body.md") + ATTRIBUTION)
        if rc:
            sys.exit(f"pr create failed: {err}")
        number = int(out.rstrip("/").rsplit("/", 1)[1])
        print(f"opened draft PR #{number}")
    while (state := checks(up, number, head)) in ("pending", "none"):
        time.sleep(30)  # the fact decides; the sleep only spaces the reads
    if state != "success":
        sys.exit(f"CI {state} at {head[:9]} on PR #{number}: stays draft, no comment")
    print(f"CI green at {head[:9]}")
    comment = text(slug, "pr-comment.md")
    body = (comment if head[:9] in comment else f"Updated to {head[:9]}.") + ATTRIBUTION + f"\n<!-- hd:{head[:12]} -->"
    rc, out, _ = sh("gh", "pr", "view", str(number), "-R", up, "--json", "comments")
    mine = [x for x in (json.loads(out).get("comments") if rc == 0 else []) if f"<!-- hd:{head[:12]} -->" in x.get("body", "")]
    if mine:
        sh("gh", "api", "graphql", "-f", "query=mutation($id:ID!,$b:String!){updateIssueComment(input:{id:$id,body:$b}){issueComment{id}}}", "-f", f"id={mine[0]['id']}", "-f", f"b={body}")
    else:
        sh("gh", "pr", "comment", str(number), "-R", up, "--body", body)
    print("commented, naming the head")
    rc, _, err = sh("gh", "pr", "ready", str(number), "-R", up)
    print(f"PR #{number} ready for review" if rc == 0 else f"ready failed: {err}")
    sys.exit(rc)


def release(slug, head, tag):
    if not approved(slug, head):
        sys.exit(f"refused: no approval at {head}")
    c = yaml.safe_load((ROOT / "hd.yaml").read_text())
    ev = EVID / slug
    assets = [str(ev / n) for n in ("osrs-runelite.apk", "THIRD_PARTY_NOTICES.md") if (ev / n).exists()] + [str(f) for f in ev.glob("repack*.log")]
    if len(assets) < 2:
        sys.exit(f"refused: {ev} lacks the APK or the notices")
    rc, out, err = sh("gh", "release", "create", tag, "-R", c["repos"]["client"]["name"], "--target", head, "--title", tag,
                      "--notes", text(slug, "release-notes.md") + ATTRIBUTION, *assets)
    print(out if rc == 0 else f"release failed: {err}")
    sys.exit(rc)


if __name__ == "__main__":
    {"upstream": upstream, "release": release}[sys.argv[1]](*sys.argv[2:])
